{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "heydesk",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "run",
        "uvicorn",
        "heydesk.main:app",
        "--reload",
        "--port",
        "8000"
      ],
      "port": 8000
    },
    {
      "name": "heydesk-shop",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "DEV_AGENT_KIND=shop",
        "DEV_AGENT_SEED=examples/agents/shop.yaml",
        "uv",
        "run",
        "uvicorn",
        "heydesk.main:app",
        "--port",
        "8000"
      ],
      "port": 8000
    },
    {
      "name": "heydesk-fake",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "LLM_PROVIDER=fake",
        "uv",
        "run",
        "uvicorn",
        "heydesk.main:app",
        "--port",
        "8000"
      ],
      "port": 8000
    },
    {
      "name": "heydesk-fake-nomail",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "LLM_PROVIDER=fake",
        "BREVO_API_KEY=",
        "uv",
        "run",
        "uvicorn",
        "heydesk.main:app",
        "--port",
        "8000"
      ],
      "port": 8000
    },
    {
      "name": "heydesk-fake-shop",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "LLM_PROVIDER=fake",
        "DEV_AGENT_KIND=shop",
        "DEV_AGENT_SEED=examples/agents/shop.yaml",
        "uv",
        "run",
        "uvicorn",
        "heydesk.main:app",
        "--port",
        "8000"
      ],
      "port": 8000
    },
    {
      "name": "heydesk-bangla-shop",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "DEV_AGENT_KIND=shop",
        "DEV_AGENT_SEED=examples/agents/shop-bn.yaml",
        "uv",
        "run",
        "uvicorn",
        "heydesk.main:app",
        "--port",
        "8000"
      ],
      "port": 8000
    },
    {
      "name": "bangla-tts",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "run",
        "--directory",
        "tts_server",
        "uvicorn",
        "server:app",
        "--port",
        "8010"
      ],
      "port": 8010
    },
    {
      "name": "frontend",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--dir",
        "../heydesk-frontend",
        "run",
        "serve"
      ],
      "port": 8080
    },
    {
      "name": "widget-test",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "run",
        "--no-project",
        "python",
        "-m",
        "http.server",
        "5500",
        "--directory",
        "../heydesk-frontend/dev/widget-test"
      ],
      "port": 5500
    }
  ]
}
