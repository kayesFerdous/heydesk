# Copy to .env. Every setting HeyDesk reads; defaults shown.

# development | test | production (production refuses fake providers, and an empty JWT_SECRET or SECRETS_KEY)
APP_ENV=development
# SQLite for the MVP (Postgres is not wired up yet)
DATABASE_URL=sqlite+aiosqlite:///./heydesk.db
# Signs login tokens. Required in production: a long random string
JWT_SECRET=
# Encrypts the bot tokens and store passwords businesses give us (D74). Required in production:
# a long random string (openssl rand -hex 32). Set it once: a new key can't read the saved ones
SECRETS_KEY=
# Origins allowed to call the API (JSON list)
CORS_ORIGINS=["http://localhost:5173"]

# gigalogy | groq | fake. Gigalogy calls tools as JSON in its reply (D16)
LLM_PROVIDER=gigalogy
GROQ_API_KEY=
# Gigalogy Maira: the profile picks the model. The project key and API key come from
# one credential's downloaded JSON; the project ID is NOT the key. See docs/gigalogy.md
GIGALOGY_PROJECT_KEY=
GIGALOGY_API_KEY=
GIGALOGY_PROFILE_ID=
# Groq's model for every agent
MODEL=openai/gpt-oss-120b

# The knowledge base (D33, D34). Documents are embedded by Gemini and searched in Qdrant.
# gemini | fake (fake knows words only: for offline development)
EMBEDDER=gemini
GEMINI_API_KEY=
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSIONS=768
# Qdrant Cloud's cluster URL and key. Leave the URL empty to use a local folder instead
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_LOCAL_PATH=./qdrant_local
QDRANT_COLLECTION=heydesk_chunks
# Passages scoring below this meaning-similarity are left out (0.6 fits Gemini; see config.py)
KNOWLEDGE_MIN_SIMILARITY=0.6

# Photos (D57): product photos and the ones visitors send are kept here, and searched in their
# own Qdrant collection. A product photo scoring below this isn't like the visitor's at all
MEDIA_DIR=./media
# Or in a Cloudflare R2 bucket (D101): set the bucket, an R2 API token's key id and secret (Object
# Read & Write), and the bucket's public address (its r2.dev URL or a connected domain)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=
QDRANT_PHOTO_COLLECTION=heydesk_photos
PHOTO_MIN_SIMILARITY=0.75

# How often, in minutes, a linked Google Sheet is read again (D58)
SHEET_SYNC_MINUTES=5

# How often, in minutes, a linked WooCommerce store is synced when it has no webhooks (no https
# PUBLIC_URL): our orders written, its products read (D75). With webhooks: when Woo says, and every 30 (D78)
WOO_SYNC_MINUTES=2

# Speech-to-text on voice calls: deepgram | chorus | whisper (Chorus uses the Gigalogy keys above).
# whisper is our Bangla–English Whisper: run tts_server/kaggle_stt.ipynb on Kaggle and paste the
# URL it prints here (D87)
STT_PROVIDER=whisper
DEEPGRAM_API_KEY=
WHISPER_STT_URL=http://localhost:8011
# What every voice call hears and speaks (D86): bn (Deepgram in Bangla, the Bangla voice below)
# or en (Deepgram in English, Piper)
VOICE_LANGUAGE=bn
# The Bangla voice: tts_server/ on this machine (D84). For a demo on a free GPU, run
# tts_server/kaggle_tts.ipynb on Kaggle and paste the URL it prints here (D85)
BANGLA_TTS_URL=http://localhost:8010

# Voice from far away: Cloudflare's free TURN relay (dash.cloudflare.com -> Realtime -> TURN)
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=
# A voice call hangs up after this many seconds
MAX_CALL_SECONDS=300
# Calls to confirm shop orders (D89): how often the queue is checked, how long a ring lasts,
# and how many calls at once (the Bangla voice speaks one sentence at a time)
CALL_QUEUE_SECONDS=5
RING_SECONDS=30
MAX_LIVE_CALLS=1

# The public link, https://… Telegram sends its messages here (D42), WooCommerce its webhooks (D78), and in development
# scripts/dev.sh puts the frontend on it with ngrok (your ngrok domain). Empty: localhost only
PUBLIC_URL=

# Messenger (D60) and WhatsApp (D103): our Meta app's secret, and the verify token typed into
# its webhook settings (callbacks PUBLIC_URL/api/messenger, field: messages, messaging_postbacks;
# and PUBLIC_URL/api/whatsapp, field: messages)
META_APP_SECRET=
MESSENGER_VERIFY_TOKEN=

# Paying first (D47-D49, D109): each business connects its own SSLCommerz store, its own bKash
# account, or both, on the frontend (Agent settings -> Payments). sslcommerz: the real
# gateways, both of them; fake: no network, for tests
PAYMENTS=sslcommerz
# Businesses paying HeyDesk for a plan (D106): our own SSLCommerz store. Empty: the billing
# page can't take payments online, and an admin sets plans by hand
BILLING_STORE_ID=
BILLING_STORE_PASSWORD=
BILLING_SANDBOX=true
# ...and our own bKash merchant account (D109), Tokenized Checkout. Empty: no bKash button.
# bKash's published sandbox keys (unverified): app key 4f6o0cjiki2rfm34kfdadl1eqq, app secret
# 2is7hdktrekvrbljjh44ll3d9l1dtjo4pasmjvs5vl5qr3fug4b, username sandboxTokenizedUser02,
# password sandboxTokenizedUser02@12345; test wallet 01770618575, OTP 123456, PIN 12121
BILLING_BKASH_APP_KEY=
BILLING_BKASH_APP_SECRET=
BILLING_BKASH_USERNAME=
BILLING_BKASH_PASSWORD=
BILLING_BKASH_SANDBOX=true

# Email (D93): the codes that verify an owner's email and reset a password. Brevo (brevo.com,
# free for 300 a day): an API key (SMTP & API -> API keys) and a sender verified there (Senders,
# domains). Required in production; empty in development prints each email in the terminal
BREVO_API_KEY=
MAIL_FROM=

# On Telegram, a message after this many quiet hours starts a new conversation
CONVERSATION_IDLE_HOURS=12

# The agent served at / in development: its desk (restaurant, clinic, receptionist, shop) and seed.
#   DEV_AGENT_KIND=clinic  DEV_AGENT_SEED=examples/agents/clinic.yaml
DEV_AGENT_KIND=restaurant
DEV_AGENT_SEED=examples/agents/restaurant.yaml

# Longest visitor message accepted
MAX_MESSAGE_CHARS=2000

# Visitor messages per conversation before it asks for a new one (D21)
MAX_TURNS=60

# Limits on the public chat (D51), in the business's local day: turns per visitor, turns for the
# whole business, off-topic turns in a row before a visitor is blocked, and for how long
VISITOR_DAILY_TURNS=30
WORKSPACE_DAILY_TURNS=500
OFF_TOPIC_STRIKES=5
BLOCK_HOURS=24

LOG_LEVEL=INFO
# false for readable lines in development
LOG_JSON=true
