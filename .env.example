# Copy to .env. Every setting HeyDesk reads; defaults shown.

# development | test | production (production refuses fake providers and an empty JWT_SECRET)
APP_ENV=development
# SQLite now; postgresql+asyncpg://… in the production phase
DATABASE_URL=sqlite+aiosqlite:///./heydesk.db
# Signs login tokens. Required in production: a long random string
JWT_SECRET=
# Origins allowed to call the API (JSON list)
CORS_ORIGINS=["http://localhost:5173"]

# gigalogy | groq | fake. Gigalogy calls tools as JSON in its reply (D16)
LLM_PROVIDER=gigalogy
GROQ_API_KEY=
# Gigalogy Maira: the profile picks the model. The project key and API key come from
# one credential's downloaded JSON; the project ID is NOT the key. See docs/gigalogy.md
GIGALOGY_PROJECT_KEY=
GIGALOGY_API_KEY=
GIGALOGY_PROFILE_ID=
# Groq's model for every agent
MODEL=openai/gpt-oss-120b

# jev | fake
DECIDER=fake
TYPESAFE_API_KEY=
# Pin a version the day a judgment changes under you
TYPESAFE_MODEL=jev-latest
# Seconds before a Jev call counts as unavailable
TYPESAFE_TIMEOUT=5.0

# The knowledge base (D33, D34). Documents are embedded by Gemini and searched in Qdrant.
# gemini | fake (fake knows words only: for offline development)
EMBEDDER=gemini
GEMINI_API_KEY=
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSIONS=768
# Qdrant Cloud's cluster URL and key. Leave the URL empty to use a local folder instead
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_LOCAL_PATH=./qdrant_local
QDRANT_COLLECTION=heydesk_chunks
# Passages scoring below this meaning-similarity are left out (0.6 fits Gemini; see config.py)
KNOWLEDGE_MIN_SIMILARITY=0.6

# Speech-to-text on voice calls: deepgram | chorus (Chorus uses the Gigalogy keys above)
STT_PROVIDER=deepgram
DEEPGRAM_API_KEY=

# Voice from far away: Cloudflare's free TURN relay (dash.cloudflare.com -> Realtime -> TURN)
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=
# A voice call hangs up after this many seconds
MAX_CALL_SECONDS=300

# The public link, https://… Telegram sends its messages here (D42), and in development
# scripts/dev.sh puts the frontend on it with ngrok (your ngrok domain). Empty: localhost only
PUBLIC_URL=
# On Telegram, a message after this many quiet hours starts a new conversation
CONVERSATION_IDLE_HOURS=12

# The agent served at / in development: its desk (restaurant, clinic, receptionist) and seed.
#   DEV_AGENT_KIND=clinic  DEV_AGENT_SEED=examples/agents/clinic.yaml
DEV_AGENT_KIND=restaurant
DEV_AGENT_SEED=examples/agents/restaurant.yaml

# Longest visitor message accepted
MAX_MESSAGE_CHARS=2000

# Visitor messages per conversation before it asks for a new one (D21)
MAX_TURNS=60

LOG_LEVEL=INFO
# false for readable lines in development
LOG_JSON=true
